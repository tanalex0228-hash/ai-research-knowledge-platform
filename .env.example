# Safe local defaults only. Copy to .env and replace every production value.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
# Leave blank for the built-in local SQLite database. PostgreSQL example:
# DATABASE_URL=postgresql://research_app:replace-me@localhost:5432/research_platform
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
FILE_STORAGE_PATH=/srv/research-platform/files
MAX_PDF_UPLOAD_BYTES=26214400
AI_PROVIDER=disabled
AI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
LLM_MODEL=
PUBLIC_BASE_URL=http://localhost:8000
ENVIRONMENT=local
